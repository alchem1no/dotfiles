[
  {
    "name": "top-bar",
    "layer": "top",
    "position": "top",
    "margin": "6 8 0 8",
    "height": 30,
    "spacing": 4,
    "modules-left": [
      "custom/launcher",
      "hyprland/workspaces",
      "hyprland/submap",
      "cpu",
      "temperature",
      "memory",
      "disk"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "idle_inhibitor",
      "tray",
      "custom/numlock",
      "hyprland/language",
      "backlight",
      "wireplumber",
      "network",
      "bluetooth",
      "battery",
      "custom/power"
    ],
    "custom/launcher": {
      "format": "󰣇",
      "on-click": "nc -U /run/user/$(id -u)/walker/walker.sock",
      "on-click-middle": "hyprsysteminfo",
      "tooltip": true,
      "tooltip-format": "Launcher"
    },
    "hyprland/workspaces": {
      "disable-scroll": true,
      "warp-on-scroll": false,
      "all-outputs": true,
      "format": "{name} {icon}",
      "format-icons": {
        "1": " ",
        "2": " ",
        "3": " ",
        "4": " ",
        "5": " ",
        "urgent": " ",
        "default": " "
      },
      "persistent-workspaces": {
        "*": 5
      }
    },
    "cpu": {
      "format": "{usage}% ",
      "tooltip": true,
      "tooltip-format": "CPU"
    },
    "temperature": {
      "thermal-zone": 2,
      "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
      "critical-threshold": 80,
      "format-critical": "{temperatureC}°C {icon}",
      "format": "{temperatureC}°C {icon}",
      "format-icons": [
        "󰉬",
        "",
        "󰉪"
      ],
      "tooltip": true,
      "tooltip-format": "{temperatureC}°C / {temperatureF}°F"
    },
    "memory": {
      "format": "{}% ",
      "tooltip": true,
      "tooltip-format": "RAM:  {used}Gi / {total}Gi\nSwap: {swapUsed}Gi / {swapTotal}Gi"
    },
    "disk": {
      "interval": 60,
      "format": "{percentage_used}% "
    },
    "clock": {
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format-alt": "{:%Y-%m-%d}"
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": " ",
        "deactivated": " "
      },
      "tooltip": true,
      "tooltip-format-activated": "Stay awake: On",
      "tooltip-format-deactivated": "Stay awake: Off"
    },
    "tray": {
      "icon-size": 18,
      "spacing": 6
    },
    "custom/numlock": {
      "exec": "cat /sys/class/leds/input*::numlock/brightness 2>/dev/null | head -1 | awk '{print ($1==1) ? \"{\\\"text\\\":\\\"Num\\\",\\\"class\\\":\\\"locked\\\",\\\"tooltip\\\":\\\"Num Lock: ON\\\"}\" : \"{\\\"text\\\":\\\"Num\\\",\\\"class\\\":\\\"\\\",\\\"tooltip\\\":\\\"Num Lock: OFF\\\"}\"}'",
      "interval": 1,
      "return-type": "json",
      "tooltip": true,
      "on-click": "ydotool key 69:1 69:0"
    },
    "hyprland/language": {
      "format": "{}",
      "format-en": "en",
      "format-ru": "ru",
      "keyboard-name": "kanata",
      "on-click": "hyprctl switchxkblayout kanata next"
    },
    "backlight": {
      "format": "{percent}% {icon}",
      "format-icons": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ],
      "scroll-step": 4,
      "smooth-scrolling-threshold": 1,
      "on-scroll-up": "brillo -q -e -u 120000 -A 5",
      "on-scroll-down": "brillo -q -e -u 120000 -U 5",
      "tooltip": true,
      "tooltip-format": "Screen brightness"
    },
    "wireplumber": {
      "format": "{volume}% {icon}",
      "format-muted": "",
      "format-icons": [
        "",
        "",
        ""
      ],
      "tooltip": true,
      "tooltip-format": "Volume",
      "max-volume": 100,
      "scroll-step": 5,
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-right": "pwvucontrol",
      "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "network": {
      "interval": 5,
      "format": "{ifname}",
      "format-wifi": "{signalStrength}% {icon}",
      "format-ethernet": "{icon}",
      "format-linked": "{ifname} (No IP) {icon}",
      "format-disconnected": "{icon}",
      "format-disabled": "{icon}",
      "format-icons": {
        "wifi": [
          "󰤯 ",
          "󰤟 ",
          "󰤢 ",
          "󰤥 ",
          "󰤨 "
        ],
        "ethernet": "󰈀 ",
        "disconnected": "󰤭 ",
        "linked": "󰈂 ",
        "disabled": "󰅙 "
      },
      "tooltip": true,
      "tooltip-format": "{ifname}: {ipaddr}",
      "tooltip-format-wifi": "{essid}\nSignal strength: {signalStrength}%\n↑ {bandwidthUpBits} ↓ {bandwidthDownBits}",
      "tooltip-format-ethernet": "{ifname}\n↑ {bandwidthUpBits} ↓ {bandwidthDownBits}",
      "tooltip-format-disconnected": "Disconnected",
      "on-click": "networkmanager_dmenu",
      "on-click-right": "nm-connection-editor",
      "on-click-middle": "kitty -e nmtui",
      "max-length": 50
    },
    "bluetooth": {
      "format": "{icon}",
      "format-icons": {
        "enabled": "󰂯",
        "disabled": "󰂲",
        "connected": "󰂱"
      },
      "on-click": "fuzzel-bluetooth",
      "on-click-right": "kitty -e bluetuith",
      "on-click-middle": "blueman-manager"
    },
    "battery": {
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{capacity}% {icon}",
      "format-full": "{capacity}% {icon}",
      "format-charging": "{capacity}% 󰃨",
      "format-plugged": "{capacity}% ",
      "format-alt": "{time} {icon}",
      "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ],
      "tooltip": true,
      "tooltip-format": "Work/Charge time: {time}\nPower: {power}W\nHealth: {health}%\nCycles: {cycles}"
    },
    "custom/power": {
      "format": "⏻",
      "tooltip": true,
      "tooltip-format": "Power menu",
      "menu": "on-click",
      "menu-file": "$HOME/.config/waybar/custom_modules/power_menu.xml",
      "menu-actions": {
        "shutdown": "poweroff",
        "reboot": "reboot",
        "suspend": "systemctl suspend",
        "hibernate": "systemctl hibernate",
        "log-out": "hyprshutdown"
      }
    }
  },
  {
    "name": "bottom-bar",
    "layer": "top",
    "position": "bottom",
    "margin": "0 8 6 8",
    "height": 30,
    "spacing": 4,
    "modules-left": [
      "hyprland/window"
    ],
    "modules-center": [],
    "modules-right": [
      "mpris"
    ],
    "hyprland/window": {
      "format": "{}",
      "tooltip": true,
      "tooltip-format": "Active window",
      "separate-outputs": true,
      "icon": true,
      "icon-size": 24,
      "expand": false
    },
    "mpris": {
      "format": "{dynamic} {status_icon} {title} - {artist} | Album: {album}",
      "format-stopped": "{status_icon} Nothing is playing",
      "player-icons": {
        "default": ""
      },
      "status-icons": {
        "playing": "",
        "paused": "",
        "stopped": ""
      },
      "dynamic-order": [
        "position",
        "length"
      ],
      "tooltip": true,
      "tooltip-format": "MPRIS ({status})",
      "interval": 1,
      "truncate-hours": true
    }
  }
]
